{
  "$schema": "../../schema/manifest.schema.json",
  "id": "calendar-feeds",
  "name": "Calendar feeds",
  "version": "2.0.1",
  "kind": "extension",
  "author": "Enplace",
  "summary": "Show your calendars on the timeline so plans fit around meetings.",
  "description": "Subscribe to any calendar's private iCal link (Google, iCloud, Outlook). Events show as busy blocks on Calendar and Today, refreshed every 15 minutes. Read-only: nothing is ever written back.",
  "colour": "#b79cff",
  "icon": "calendar",
  "glyph": [
    { "d": "M7 5L17 5C18.93 5 20.5 6.57 20.5 8.5L20.5 17C20.5 18.93 18.93 20.5 17 20.5L7 20.5C5.07 20.5 3.5 18.93 3.5 17L3.5 8.5C3.5 6.57 5.07 5 7 5Z", "paint": "soft" },
    { "d": "M7 5L17 5C18.93 5 20.5 6.57 20.5 8.5L20.5 17C20.5 18.93 18.93 20.5 17 20.5L7 20.5C5.07 20.5 3.5 18.93 3.5 17L3.5 8.5C3.5 6.57 5.07 5 7 5Z" },
    { "d": "M8 3L8 6.5M16 3L16 6.5" },
    { "d": "M8 13C10.21 13 12 14.79 12 17M8 9.75C12 9.75 15.25 13 15.25 17" },
    { "d": "M9.7 16.6C9.7 17.32 9.12 17.9 8.4 17.9C7.68 17.9 7.1 17.32 7.1 16.6C7.1 15.88 7.68 15.3 8.4 15.3C9.12 15.3 9.7 15.88 9.7 16.6Z", "paint": "solid" }
  ],
  "scope": "workspace",
  "default": true,
  "permissions": { "fetch_links": true },
  "contributes": {
    "calendar": true,
    "schedule": { "every": 15, "per": "workspace" },
    "settings_panel": true
  }
}
