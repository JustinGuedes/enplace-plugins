{
  "$schema": "../../schema/manifest.schema.json",
  "id": "xp",
  "name": "XP",
  "version": "1.1.0",
  "author": "Enplace",
  "summary": "Turn finished work into XP, levels, streaks, quests and badges.",
  "description": "You become a character and each project you switch XP on for becomes a skill you name (the gym could be Strength). Finished work earns XP, more for higher priority and bigger estimates. Keep a daily streak, clear this week's quests for bonus XP, earn badges, and unlock each skill's tree as it levels up.",
  "colour": "#ffc069",
  "icon": "star",
  "glyph": [
    { "d": "M12 2.5L20 7L20 17L12 21.5L4 17L4 7Z", "paint": "soft" },
    { "d": "M12 2.5L20 7L20 17L12 21.5L4 17L4 7Z" },
    { "d": "M8.5 12L12 8.5L15.5 12M8.5 16L12 12.5L15.5 16" }
  ],
  "scope": "both",
  "inherit": "down",
  "card_settings": ["skill"],
  "permissions": { "read": ["projects", "work"] },
  "settings": [
    { "key": "difficulty", "name": "Quest difficulty", "type": "select", "scope": "workspace", "options": ["Gentle", "Normal", "Hard"], "default": "Normal", "help": "How much this week's quests ask of you." },
    { "key": "skill", "name": "Skill name", "type": "text", "scope": "project", "help": "What this project trains, like Strength for the gym. Blank uses the project's name." },
    { "key": "icon", "name": "Skill icon", "type": "select", "scope": "project", "options": ["star", "dumbbell", "book", "code", "brush", "music", "heart", "leaf", "coin", "rocket", "shield", "bolt"], "default": "star" }
  ],
  "contributes": {
    "brief": true,
    "rail_chip": true,
    "dashboard": [
      { "key": "streak", "name": "Streak", "size": "small" },
      { "key": "quests", "name": "This week's quests", "size": "wide" },
      { "key": "badges", "name": "Badges", "size": "small" }
    ],
    "project_cards": [ { "key": "skill", "name": "Skill", "size": "small" } ],
    "pages": [
      { "key": "character", "name": "Character", "icon": "star", "where": "workspace" },
      { "key": "skill", "name": "Skill tree", "icon": "star", "glyph": [{"d": "M14.75 5.5C14.75 7.02 13.52 8.25 12 8.25C10.48 8.25 9.25 7.02 9.25 5.5C9.25 3.98 10.48 2.75 12 2.75C13.52 2.75 14.75 3.98 14.75 5.5Z", "paint": "soft"},{"d": "M14.75 5.5C14.75 7.02 13.52 8.25 12 8.25C10.48 8.25 9.25 7.02 9.25 5.5C9.25 3.98 10.48 2.75 12 2.75C13.52 2.75 14.75 3.98 14.75 5.5Z"},{"d": "M12 8.25L12 16.5M5 16.5L5 14C5 12.9 5.9 12 7 12L17 12C18.1 12 19 12.9 19 14L19 16.5"},{"d": "M7 18.75C7 19.85 6.1 20.75 5 20.75C3.9 20.75 3 19.85 3 18.75C3 17.65 3.9 16.75 5 16.75C6.1 16.75 7 17.65 7 18.75Z"},{"d": "M21 18.75C21 19.85 20.1 20.75 19 20.75C17.9 20.75 17 19.85 17 18.75C17 17.65 17.9 16.75 19 16.75C20.1 16.75 21 17.65 21 18.75Z"},{"d": "M14.25 18.75C14.25 19.99 13.24 21 12 21C10.76 21 9.75 19.99 9.75 18.75C9.75 17.51 10.76 16.5 12 16.5C13.24 16.5 14.25 17.51 14.25 18.75Z", "paint": "solid"}], "where": "project" }
    ],
    "look": { "optional": true, "tokens": { "--accent": "#ffc069", "--accent-ink": "#2b1a00" } },
    "events": ["work.done"]
  }
}
